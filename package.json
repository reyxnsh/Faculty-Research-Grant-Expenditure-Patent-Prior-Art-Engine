{
  "name": "grant-priorart-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migrate:up",
    "migrate:up": "node-pg-migrate --no-verbose --envPath .env -m migrations up",
    "migrate:down": "node-pg-migrate --no-verbose --envPath .env -m migrations down",
    "migrate:create": "node-pg-migrate -m migrations create",
    "create-admin": "node scripts/createAdmin.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dotenv": "^18.0.9",
    "jose": "^6.2.14",
    "next": "16.4.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
