# Database Configuration (Admin credentials for migrations and container initialization)
POSTGRES_USER=grant_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=grant_priorart_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Restricted Application Role (Used by Next.js runtime backend; letters and digits only)
APP_DB_USER=grant_app
APP_DB_PASSWORD=your_app_password_here

# Full connection string for node-pg-migrate and administrative operations
DATABASE_URL=postgres://grant_admin:your_secure_password_here@localhost:5433/grant_priorart_db
